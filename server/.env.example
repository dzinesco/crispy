# Port the API listens on. Vite dev server proxies /api -> this port.
PORT=3102

# Comma-separated list of origins allowed to call the API. Use the public site
# URL in production; localhost in dev.
CORS_ORIGIN=http://localhost:5173,https://crispygoat.com,https://www.crispygoat.com

# Public site URL — used for Stripe Checkout return URLs.
SITE_URL=https://crispygoat.com

# JWT secret for admin sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin (created on first boot if no admin exists).
ADMIN_EMAIL=admin@crispygoat.com
ADMIN_PASSWORD=change-me-too

# Stripe — both required for /api/stripe/checkout to return a real URL.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Path to the SQLite file.
DATABASE_FILE=./data/crispy.db
