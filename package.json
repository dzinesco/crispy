{
  "name": "crispy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "npm run build:goatshop && vite build",
    "build:goatshop": "vite build --config apps/goatshop/vite.config.js",
    "lint": "node scripts/lint.mjs",
    "test:macos8": "node tests/macos8.spec.mjs",
    "test:deskmate": "node tests/deskmate.spec.mjs",
    "test:goatshop": "node tests/goatshop.spec.mjs",
    "test:defrag": "node tests/defrag.spec.mjs",
    "preview": "vite preview",
    "install:all": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "marked": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  }
}
